{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableRemoteControl": true,
  "disableSkillShellExecution": true,
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [],
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterWorktree",
      "ExitWorktree",
      "LSP",
      "ListMcpResourcesTool",
      "Monitor",
      "mcp__.*",
      "PowerShell",
      "ReadMcpResourceTool",
      "SendMessage",
      "Skill",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/**)",
      "Edit(./.codex/**)",
      "Edit(./.git/**)",
      "Edit(./.github/**)",
      "Edit(./config/**)",
      "Edit(./docs/**)",
      "Edit(./specs/**)",
      "Edit(./tools/**)",
      "Edit(./.gitattributes)",
      "Edit(./.gitignore)",
      "Edit(./.node-version)",
      "Edit(./.npmrc)",
      "Edit(./.nvmrc)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./eslint.config.mjs)",
      "Edit(./package-lock.json)",
      "Edit(./package.json)",
      "Edit(./tsconfig.json)",
      "Edit(./vitest.config.mjs)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const fs=require('node:fs'),path=require('node:path'),url=require('node:url');let dir=process.env.CLAUDE_PROJECT_DIR||process.cwd();while(!fs.existsSync(path.join(dir,'tools','guard-claude-tool.mjs'))){const parent=path.dirname(dir);if(parent===dir)process.exit(2);dir=parent};import(url.pathToFileURL(path.join(dir,'tools','guard-claude-tool.mjs')).href).then(module=>module.runCli()).catch(()=>process.exit(2))\"",
            "timeout": 10,
            "statusMessage": "Checking the personal-account boundary"
          }
        ]
      }
    ]
  }
}
