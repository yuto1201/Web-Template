{
  "name": "web-template",
  "version": "0.2.0",
  "private": true,
  "description": "Issue-driven Next.js, Supabase, Vercel, and Cloudflare web application template",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "auth:verify": "node tools/verify-auth-integration.mjs",
    "db:verify": "node tools/verify-database.mjs",
    "db:stop": "npm exec -- supabase stop --no-backup",
    "deployment:lint": "node tools/deployment-workflow.mjs lint",
    "domain:lint": "node tools/domain-workflow.mjs lint",
    "build": "next build",
    "build:ci": "node tools/build-ci.mjs",
    "start": "next start",
    "generate": "node tools/generate-agent-wrappers.mjs",
    "workflow": "node tools/issue-workflow.mjs",
    "check:generated": "node tools/generate-agent-wrappers.mjs --check",
    "lint": "eslint .",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:boundary": "node tools/verify-server-boundary.mjs",
    "test:client-scan": "node tools/verify-client-scan.mjs",
    "test:e2e": "playwright test",
    "scan:client": "node tools/scan-client-bundle.mjs",
    "check": "npm run check:generated && npm run deployment:lint && npm run domain:lint && npm run lint && npm run typecheck && npm test && npm run test:boundary && npm run test:client-scan && npm run build:ci"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "supabase": "2.115.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
