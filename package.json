{
  "name": "web-template",
  "version": "0.1.0",
  "private": true,
  "description": "Issue-driven Next.js, Supabase, Vercel, and Cloudflare web application template",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "scripts": {
    "generate": "node tools/generate-agent-wrappers.mjs",
    "check:generated": "node tools/generate-agent-wrappers.mjs --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check:generated && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
