# Browser-visible values. Never place service-role keys or provider tokens here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>

# Required server policy. Public sign-up is disabled unless this exact value is changed.
APP_ORIGIN=http://localhost:3000
AUTH_SIGNUP_MODE=disabled

# Server-only and optional until a server feature explicitly requires it.
# SUPABASE_SERVICE_ROLE_KEY=
