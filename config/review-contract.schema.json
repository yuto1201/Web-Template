{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opposite-model review result",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "primaryModelFamily": { "const": "gpt" } }, "required": ["primaryModelFamily"] },
      "then": { "properties": { "reviewerModelFamily": { "const": "claude" } } }
    },
    {
      "if": { "properties": { "primaryModelFamily": { "const": "claude" } }, "required": ["primaryModelFamily"] },
      "then": { "properties": { "reviewerModelFamily": { "const": "gpt" } } }
    },
    {
      "if": { "properties": { "verdict": { "const": "unavailable" } }, "required": ["verdict"] },
      "then": { "required": ["unavailableReason"] },
      "else": { "not": { "required": ["unavailableReason"] } }
    },
    {
      "if": { "properties": { "verdict": { "const": "approved" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "findings": {
            "items": { "properties": { "blocking": { "const": false } } }
          }
        }
      }
    }
  ],
  "required": [
    "schemaVersion",
    "issue",
    "primaryOperatorLabel",
    "reviewerOperatorLabel",
    "primaryModelFamily",
    "reviewerModelFamily",
    "headSha",
    "verifySha",
    "contractDigest",
    "verdict",
    "contracts",
    "findings",
    "acceptanceAssessment",
    "reviewedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "issue": { "type": "integer", "minimum": 1 },
    "primaryOperatorLabel": { "enum": ["codex", "claude"] },
    "reviewerOperatorLabel": { "enum": ["codex", "claude"] },
    "primaryModelFamily": { "enum": ["gpt", "claude"] },
    "reviewerModelFamily": { "enum": ["gpt", "claude"] },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "verifySha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "contractDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "verdict": { "enum": ["approved", "changes-requested", "unavailable"] },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["change-evaluator", "supabase-auditor"] }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "blocking", "location", "summary"],
        "properties": {
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "blocking": { "type": "boolean" },
          "location": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "severity": { "enum": ["critical", "high"] } }, "required": ["severity"] },
            "then": { "properties": { "blocking": { "const": true } } }
          }
        ]
      }
    },
    "acceptanceAssessment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidenceRef"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" },
          "status": { "enum": ["supported", "unsupported"] },
          "evidenceRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "unavailableReason": { "type": "string", "enum": ["timeout", "command-missing", "invalid-output"] }
  }
}
